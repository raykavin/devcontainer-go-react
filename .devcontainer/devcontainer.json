{
    "name": "my-app DevContainer (Go + React)",
    "workspaceFolder": "/workspaces",
    "dockerComposeFile": [
        "docker-compose.yml"
    ],
    "service": "workspace",
    "remoteUser": "vscode",
    "containerEnv": {
        "TZ": "America/Belem",
        "PKG_MANAGER": "pnpm",
        "PROJECT_NAME": "my-app",
        "GIT_CONFIG_DEV_USERNAME": "your_username",
        "GIT_CONFIG_DEV_EMAIL": "your_email@domain.com",
        "GIT_CONFIG_TOKEN": "",
        "GIT_REPO_ADDRESS": "github.com/your_username/my-app.git",
        "GIT_INIT_DEFAULT_BRANCH": "feat/initial-setup",
        "GO_PROXY_HOST": "",
        "GO_PROXY_PORT": "",
        "VITE_API_BASE_URL": "http://localhost:8080"
    },
    "forwardPorts": [
        3000,
        8080
    ],
    "portsAttributes": {
        "3000": {
            "label": "Backend (Go API)",
            "onAutoForward": "notify"
        },
        "8080": {
            "label": "Frontend (Vite)",
            "onAutoForward": "openBrowser",
            "visibility": "public"
        }
    },
    "postStartCommand": "sudo chown -R vscode:vscode /home/vscode/.claude /home/vscode/.pnpm-store",
    "postCreateCommand": "sh ./.devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go",
                "liuchao.go-struct-tag",
                "yokoe.vscode-postfix-go",
                "neonxp.gotools",
                "tooltitudeteam.tooltitude",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "dsznajder.es7-react-js-snippets",
                "streetsidesoftware.code-spell-checker",
                "streetsidesoftware.code-spell-checker-portuguese-brazilian",
                "redhat.vscode-yaml",
                "teddyandturtle.fish",
                "usernamehw.errorlens",
                "mhutchie.git-graph"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "fish",
                "go.toolsManagement.checkForUpdates": "local",
                "go.useLanguageServer": true,
                "gopls": {
                    "build.directoryFilters": [
                        "-frontend"
                    ]
                },
                "editor.formatOnSave": true,
                "[typescript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "[typescriptreact]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "[go]": {
                    "editor.defaultFormatter": "golang.go"
                },
                "eslint.workingDirectories": [
                    "frontend"
                ]
            }
        }
    }
}